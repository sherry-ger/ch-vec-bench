# ClickHouse Cloud credentials
# Find these in your ClickHouse Cloud console:
#   Settings → Connection details → HTTPS (Native interface)
#
# The HOST looks like: abc123xyz.us-east-1.aws.clickhouse.cloud
# Do NOT include https:// — just the hostname.

CLICKHOUSE_HOST=your-cluster.us-east-1.aws.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-password-here

# The database must already exist in your ClickHouse Cloud cluster.
# You can create one in the console: Databases → New database
CLICKHOUSE_DATABASE=default
